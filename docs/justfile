# invoke from repo root: just docs/ <recipe>

# bind-mounted shared uv cache (see ~/.cache/uv -> /srv/cache/uv); keeps builds inside the sandbox
export UV_CACHE_DIR := "/tmp/uv-cache"

# quarto (installed to /tmp/quarto-1.7.33, arm64 tarball; sandbox blocks ~/.local)
export QUARTO := "/tmp/quarto-1.7.33/bin/quarto"
export XDG_CACHE_HOME := "/tmp/xdg-cache"

[no-cd]
render:
    {{QUARTO}} render

[no-cd]
preview:
    {{QUARTO}} preview

[no-cd]
publish:
    {{QUARTO}} publish gh-pages

# whole-book single-column pdf: just docs/ pdf [a4|a5] [out.pdf]
# runs quarto+latex inside docker (image built once from docs/docker/Dockerfile)
[no-cd]
pdf papersize="a4" out="book.pdf":
    #!/usr/bin/env bash
    set -exuo pipefail
    docker image inspect mzoo-quarto >/dev/null 2>&1 || docker build -t mzoo-quarto docs/docker
    docker run --rm -v "$PWD:/data" -w /data mzoo-quarto \
        quarto render docs/book.qmd --to pdf -M papersize:{{papersize}} \
            -M title:"mzoo — Evolution" --output "{{out}}"
