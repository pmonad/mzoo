# invoke from repo root: just docs/ <recipe>

# bind-mounted shared uv cache (see ~/.cache/uv -> /srv/cache/uv); keeps builds inside the sandbox
export UV_CACHE_DIR := "/tmp/uv-cache"

# quarto runs only inside the mzoo-quarto docker image (built once from docs/docker/Dockerfile);
# no host install, no /tmp tarball. the container runs as the invoking user, so outputs under
# site/ and .quarto/ stay owned by you.
uid := `id -u`
gid := `id -g`
docker_run := "docker run --rm -u " + uid + ":" + gid + " -e HOME=/tmp/home -v \"$PWD:/data\" -w /data"
docker_quarto := docker_run + " mzoo-quarto quarto"

[no-cd]
render:
    docker image inspect mzoo-quarto >/dev/null 2>&1 || docker build -t mzoo-quarto docs/docker
    {{docker_quarto}} render

# live preview at http://localhost:{{port}}; watch + re-render on save
[no-cd]
preview port="4485":
    docker image inspect mzoo-quarto >/dev/null 2>&1 || docker build -t mzoo-quarto docs/docker
    {{docker_run}} -p {{port}}:{{port}} mzoo-quarto quarto preview --host 0.0.0.0 --port {{port}} --no-browser

# render in docker, push to gh-pages from the host (host git/gh auth; no git/ssh in docker)
[no-cd]
publish: render
    docs/publish.sh

# whole-book single-column pdf: just docs/ pdf [a4|a5] [out.pdf]
# runs quarto+latex inside docker (image built once from docs/docker/Dockerfile)
[no-cd]
pdf papersize="a4" out="book.pdf":
    docs/pdf.sh {{papersize}} {{out}}
