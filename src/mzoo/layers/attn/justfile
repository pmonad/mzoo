# invoke from repo root: just src/mzoo/layers/attn <recipe>
# needs CUDA 13 nvcc for sm121 (/usr/bin/nvcc is 12.0): set CUDA_HOME in repo-root .env

[no-cd]
test *args:
    uv run --env-file .env pytest src/mzoo/layers/attn {{args}}

# dense_attn kernel vs torch SDPA
[no-cd]
bench *args:
    uv run --env-file .env python -m mzoo.layers.attn.dense_attn.bench {{args}}

# latent_attn (shared K==V latent, MQA) kernel vs torch SDPA with the latent expanded to H heads
[no-cd]
bench-latent *args:
    uv run --env-file .env python -m mzoo.layers.attn.latent_attn.bench {{args}}

# swa_attn (sliding window over the shared latent) vs latent_attn full causal vs SDPA with a band mask
[no-cd]
bench-swa *args:
    uv run --env-file .env python -m mzoo.layers.attn.swa_attn.bench {{args}}

# indexer (lightning-indexer bf16 score kernel + top-k) vs a torch einsum + torch.topk baseline
[no-cd]
bench-indexer *args:
    uv run --env-file .env python -m mzoo.layers.attn.indexer.bench {{args}}

# csa_attn (window + dense compressed KV) vs swa_attn (window only) on the same inputs
[no-cd]
bench-csa *args:
    uv run --env-file .env python -m mzoo.layers.attn.csa_attn.bench {{args}}

# qk prologue: fused (torch.compile) RMSNorm+RoPE vs eager norm-then-rope; add `memory` for the autograd footprint
[no-cd]
bench-prologue *args:
    uv run --env-file .env python -m mzoo.layers.attn.norm_rope_bench main {{args}}

# csa2_attn (window + top-k gathered compressed KV) vs csa_attn (dense main loop) on the same inputs
[no-cd]
bench-csa2 *args:
    uv run --env-file .env python -m mzoo.layers.attn.csa2_attn.bench {{args}}
